# 2026-09-17: vitest가 요구하는 @types/node 버전과 pptxgenjs가 물고 있는 버전이
# 서로 안 맞아(ERESOLVE) 기본 `npm install`이 실패한다(로컬에서 --legacy-peer-deps로
# 우회했던 것과 동일한 문제 — Vercel 빌드도 기본 `npm install`만 실행해서 똑같이 걸림).
# 이 파일을 두면 Vercel을 포함해 어디서 npm install을 실행하든 자동으로 이 옵션이
# 적용된다 — 매번 --legacy-peer-deps를 손으로 기억해서 넘길 필요가 없어진다.
legacy-peer-deps=true
