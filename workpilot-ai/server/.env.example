# server/.env 로 복사해서 쓰세요 (server/.env는 .gitignore에 걸려 커밋되지 않습니다).
# 아무 키도 없으면 자동으로 MockAIProvider(규칙 기반)로 동작합니다.

# 둘 중 하나만 있어도 됩니다. 자동 감지 우선순위는 ANTHROPIC_API_KEY -> OPENAI_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 어떤 프로바이더를 쓸지 직접 고르고 싶으면 지정하세요: claude | openai | mock
# 비워두면 위 키 중 있는 걸로 자동 선택됩니다.
WORKPILOT_AI_PROVIDER=

# 프로바이더별 모델 (비워두면 기본값 사용: claude-sonnet-5 / gpt-4o-mini)
WORKPILOT_CLAUDE_MODEL=
WORKPILOT_OPENAI_MODEL=

# 서버 포트 (기본 4100)
PORT=
